# EDU-Mate local development environment example.
#
# Copy this file to .env for local use. Do not commit real API keys.

# Backend LLM. First-time users can run `scripts/dev.sh llm-config` and choose
# a provider template. These variables remain the direct/env-based config entry
# for packaged and development runs.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_IGNORE_PROXY=1
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# Kimi/Moonshot OpenAI-compatible example. kimi-k2.6 supports image_url input.
# LLM_PROVIDER=kimi
# LLM_API_KEY=
# LLM_MODEL=kimi-k2.6
# LLM_BASE_URL=https://api.moonshot.cn/v1

# OpenAI example.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# DashScope/Qwen OpenAI-compatible example.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local OpenAI-compatible example. Many local services do not require an API key.
# LLM_PROVIDER=local
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# RAG backend. Use lexical for zero-dependency local search.
# Set to llamaindex only after installing optional llama-index dependencies.
RAG_QUERY_BACKEND=lexical
# Keep post-class generation fast by default. Set to 1 only when you want each
# ended classroom to persist its own LlamaIndex directory immediately.
POST_CLASS_BUILD_RAG_INDEX=0

# Cross-session search backend. lexical is deterministic and dependency-free.
# Set to llamaindex to build/load data/indexes/global/llama_index.
GLOBAL_SEARCH_BACKEND=lexical

# Optional vector RAG / LlamaIndex embedding settings.
# Install first with: scripts/dev.sh install-rag
# Then set RAG_QUERY_BACKEND=llamaindex and/or GLOBAL_SEARCH_BACKEND=llamaindex.
RAG_EMBEDDING_BACKEND=huggingface
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_TRUST_REMOTE_CODE=false
RAG_LLAMAINDEX_LLM=disabled

# Frontend API override examples.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws

# App/packaging local frontend preview. Backend CORS allows 5173 and 4173 by
# default. Add extra browser origins when opening the app from another device.
FRONTEND_PREVIEW_PORT=4173
# CORS_ALLOW_ORIGINS=http://192.168.1.10:4173

# App-mode microphone capture. `scripts/dev.sh app` starts WhisperLive and waits
# for the frontend to create a classroom before microphone capture is posted.
APP_ENABLE_MIC=1
APP_WHISPERLIVE_PORT=9090
APP_WHISPERLIVE_READY_TIMEOUT=90
APP_MIC_AUDIO_DEVICE=auto
# APP_MIC_AUDIO_DEVICE=plughw:1,0
APP_MIC_LANGUAGE=auto
# APP_MIC_LANGUAGE=zh
# APP_MIC_LANGUAGE=en
APP_MIC_NO_SPEECH_THRESH=0.30
APP_MIC_SAME_OUTPUT_THRESHOLD=8
APP_MIC_LOOP_SESSIONS=1
APP_ENABLE_QWEN_NOTES=1
APP_QWEN_MAX_SEGMENTS_PER_UPDATE=8
# Write detailed local Qwen notes diagnostics to
# data/sessions/<session_id>/qwen_notes_debug.jsonl.
QWEN_NOTES_DEBUG_LOG=1
QWEN_NOTES_DEBUG_LOG_MAX_CHARS=20000
APP_ENABLE_CLOUD_GRAPH=1
POST_CLASS_FINAL_QWEN_NOTES=1
POST_CLASS_FINAL_NOTES_WAIT_SECONDS=240
POST_CLASS_QWEN_NOTES_TIMEOUT_SECONDS=360
POST_CLASS_QWEN_NOTES_TOKENS=1200
POST_CLASS_QWEN_MAX_SEGMENTS_PER_UPDATE=8
POST_CLASS_GRAPH_LLM_TIMEOUT_SECONDS=45
POST_CLASS_GRAPH_LLM_MAX_RETRIES=0
POST_CLASS_ARTIFACT_LLM_TIMEOUT_SECONDS=45
POST_CLASS_ARTIFACT_LLM_MAX_RETRIES=0
